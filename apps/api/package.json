{
  "name": "@saas-boilerplate/api",
  "version": "1.0.0",
  "description": "Fastify API for the SaaS boilerplate",
  "main": "./src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "dotenv -e ../../.env.development -- tsx watch src/index.ts",
    "stage": "dotenv -e ../../.env -e ../../.env.staging -- tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "dotenv -e ../../.env.production -- node dist/index.js",
    "clean": "rm -rf .turbo node_modules dist"
  },
