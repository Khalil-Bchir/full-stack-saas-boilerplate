# Staging template — copy to `.env.staging` (gitignored).
# Used by: pnpm stage, deploy/scripts/bootstrap-secrets.sh saas-staging .env.staging

NODE_ENV=staging
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@postgres.saas-staging.svc.cluster.local:5432/saas_staging?schema=public

ACCESS_TOKEN_SECRET=staging-access-token-secret-replace-before-deploy
ACCESS_TOKEN_TTL=1d
COOKIE_SECRET=staging-cookie-secret-replace-before-deploy

NEXT_PUBLIC_API_URL=https://api.staging.saas-boilerplate.io/api/v1

# In-cluster Redis (deploy/k8s/base/redis). Replace with managed Redis URL if preferred.
REDIS_URL=redis://saas-redis.saas-staging.svc.cluster.local:6379/0
AI_STREAM_KEY=ai:jobs
AI_CONSUMER_GROUP=ai-workers
AI_CACHE_TTL_SECONDS=300
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_ENABLE_WORKER=true
AI_WORKER_CONCURRENCY=1
AI_INTERNAL_TOKEN=staging-ai-internal-token-replace-before-deploy
LOG_LEVEL=INFO
