{
  "name": "@saas-boilerplate/root",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Khalil-Bchir/full-stack-saas-boilerplate.git"
  },
  "homepage": "https://github.com/Khalil-Bchir/full-stack-saas-boilerplate#readme",
  "bugs": {
    "url": "https://github.com/Khalil-Bchir/full-stack-saas-boilerplate/issues"
  },
  "author": "Khalil Bchir (https://github.com/Khalil-Bchir)",
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@saas-boilerplate/api...",
    "dev": "dotenv -e .env -e .env.development -- turbo run dev",
    "stage": "dotenv -e .env -e .env.staging -- turbo run stage",
    "test": "turbo run test",
    "start": "dotenv -e .env -e .env.production -- turbo run start",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,mdx,vue}\"",
    "clean": "rm -rf node_modules .turbo && turbo run clean",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "commit": "git-cz",
    "db:push": "turbo run db:push",
    "db:reset": "turbo run db:reset",
    "db:studio": "turbo run db:studio",
    "db:generate": "turbo run db:generate"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@commitlint/prompt-cli": "^21.2.0",
    "@saas-boilerplate/eslint-config": "workspace:*",
    "@saas-boilerplate/prettier-config": "workspace:*",
    "@saas-boilerplate/typescript-config": "workspace:*",
    "commitizen": "^4.3.2",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "inquirer": "^12.0.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "turbo": "^2.8.12"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10",
      "@hono/node-server": "^1.19.13"
    },
    "patchedDependencies": {
      "next-themes@0.4.6": "patches/next-themes@0.4.6.patch"
    }
  }
}
