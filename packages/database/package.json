{
  "name": "@saas-boilerplate/database",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf .turbo node_modules dist generated",
    "db:migrate:prod": "dotenv -e ../../.env.production -- prisma migrate deploy",
    "db:migrate:staging": "dotenv -e ../../.env.staging -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env.development -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env.development -- prisma db push",
    "db:seed:dev": "dotenv -e ../../.env.development -- prisma db seed",
    "db:seed:staging": "dotenv -e ../../.env.staging -- prisma db seed",
    "db:seed:prod": "dotenv -e ../../.env.production -- prisma db seed",
    "db:studio": "dotenv -e ../../.env.development -- prisma studio",
    "db:setup": "dotenv -e ../../.env.development -- pnpm run db:migrate:dev && pnpm run db:seed:dev",
    "db:generate": "prisma generate && prisma format",
    "db:reset:staging": "dotenv -e ../../.env.staging -- prisma migrate reset --force",
    "db:reset:dev": "dotenv -e ../../.env.development -- prisma migrate reset --force",
    "postinstall": "pnpm run db:generate",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@saas-boilerplate/types": "workspace:*",
    "@types/lodash": "^4.17.24",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lodash": "^4.18.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@saas-boilerplate/typescript-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
