{
  "name": "@saas-boilerplate/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "lint": "eslint .",
    "clean": "rm -rf .turbo node_modules"
  },
  "imports": {
