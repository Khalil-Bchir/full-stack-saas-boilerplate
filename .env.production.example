# Production template — copy to `.env.production` (gitignored).
# Used by: pnpm start, deploy/scripts/bootstrap-secrets.sh saas-production .env.production

NODE_ENV=production
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@postgres.saas-production.svc.cluster.local:5432/saas_production?schema=public

ACCESS_TOKEN_SECRET=production-access-token-secret-replace-before-deploy
ACCESS_TOKEN_TTL=1d
COOKIE_SECRET=production-cookie-secret-replace-before-deploy

NEXT_PUBLIC_API_URL=https://api.saas-boilerplate.io/api/v1

# Prefer a managed Redis in production when HA is required.
# Default points at in-cluster saas-redis Service from deploy/k8s/base/redis.
REDIS_URL=redis://saas-redis.saas-production.svc.cluster.local:6379/0
AI_STREAM_KEY=ai:jobs
AI_CONSUMER_GROUP=ai-workers
AI_CACHE_TTL_SECONDS=300
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5000
AI_ENABLE_WORKER=true
AI_WORKER_CONCURRENCY=2
AI_INTERNAL_TOKEN=production-ai-internal-token-replace-before-deploy
LOG_LEVEL=INFO
