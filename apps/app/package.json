{
  "name": "@saas-boilerplate/app",
  "version": "0.1.0",
  "private": true,
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.tsx"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -e ../../.env.development -- next dev",
    "stage": "dotenv -e ../../.env -e ../../.env.staging -- next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "dotenv -e ../../.env -e ../../.env.production -- next build",
    "start": "dotenv -e ../../.env -e ../../.env.production -- next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@saas-boilerplate/ui": "workspace:*",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "reselect": "^5.2.0",
    "three": "^0.185.1",
    "three-globe": "^2.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^27.0.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
