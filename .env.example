# Copy to `.env.development`, `.env.staging`, or `.env.production` and set real values.
# Never commit files with secrets — only the `*.example` templates are tracked in git.
#
# Templates:
#   .env.example            → development
#   .env.staging.example    → staging
#   .env.production.example → production
#
# Repository: https://github.com/Khalil-Bchir/full-stack-saas-boilerplate
# See doc/setup/environments-and-node-env.md for how env loading works.

# Runtime environment: development | staging | production
NODE_ENV=development

# API server
SERVER_PORT=8000
SERVER_HOST=localhost

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/your_database?schema=public

# JWT access token signing (use a long random string in production)
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL=1d

# Cookie signing secret (recommended for production)
COOKIE_SECRET=change-me-to-a-long-random-secret

# Next.js frontend — public API base URL (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional: graceful shutdown delay in ms (default: 500)
# FASTIFY_CLOSE_GRACE_DELAY=500
